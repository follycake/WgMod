			¡Los ataques melee infligen lindo slime brillante!
			Los efectos escalan con tu obesidad
			'''
	}

	BottomlessAppetite: {
		DisplayName: Apetito Sin Fondo
		Tooltip:
			'''
			Crea un agujero negro alrededor de ti, succionando objetos desde lejos
