NPCs: {
	GroundedHarpyNPC: {
		DisplayName: Arpía Rechoncha

		TownNPCMood: {
			Content: ¡Preferiria nunca estar en el cielo devuelta!
			NoHome: Si me vas a mantener aqui abajo contigo, ¡al menos alójame! Scraw!
			FarFromHome: Vole muy lejos en mis ejercicios!
			LoveSpace: ¡Menos humanos para molestarme! Caw!
			DislikeCrowded: ¡Por favor haz que estos humanos paren de arrullar!
			HateCrowded: Scree! ¡Burbuja personal!
			HateBiome: ¡No puedo volar en este bioma! ¡Me voy a dar la cabeza contra el techo!
			LoveNPC: ¡{NPCName} entiende como me siento de una manera que no humano podría!
			LikeNPC: "{¡NPCName} se ofrecio a armarme alas de engranajes!"
			DislikeNPC: UwU
			HateNPC: Scraw! ¡Ese {NPCName} me pinto gorda!
			LikeNPC_Princess: ¡{NPCName} es mi humana favorita! ¡Tan alegre y divertida!
			Princess_LovesNPC: ¡No sabia que arpías como {NPCName} podian ser tan amables!
			LikeBiome: Puedo ver el cielo desde aqui... ¡Algun dia volvere!
			DislikeBiome: ¡Esta f-f-frio! ¡Necesito volar al sur por el invierno!
		}

		Census.SpawnCondition: Usar {$Items.PowderedSugar.DisplayName} [i:WgMod/PowderedSugar] en un arpía
	}

	HomingFood.DisplayName: Comida Maldita

	MilkmaidNPC: {
		DisplayName: Milkmaid

		TownNPCMood: {
			Princess_LovesNPC: ¡{NPCName} es tan grande y suave!
			LikeNPC_Princess: Esa {NPCName} es una preciosa pequeña mujer.
			HateNPC: Dile a {NPCName} que si viene por aqui devuelta, voy a esperarlo con la escopeta.
			LikeNPC: "{NPCName} y yo tenemos una buena relacion de negocios."
			LoveNPC: "{NPCName} provee un servicio verdadero, no se puede decir eso sobre mucha gente en estos dias."
			DislikeNPC: Cada vez que veo a {NPCName}, ella critica mi cabello. Me gustaria ver que ella mantenga esa peluca en el rancho.
			HateBiome: ¡Esta muy caliente en este {BiomeName}! ¡No es bueno para las cosechas o los animales!
			DislikeBiome: ¿Como esperas que crezcan mis cosechas al lado del {BiomeName}?
			LikeBiome: Esta fresquito en el {BiomeName}, los bovinos como yo son gordos, ¿sabes?
			LoveBiome: Ah, el {BiomeName}... no es ideal, pero es el mejor lugar para empezar una granja en esta isla.
			HateCrowded: Ya tengo un tiempo dificil entrando en estas puertas, ¿como piensas que va a ir con toda esta gente?
			DislikeCrowded: Todo este amontonamiento de gente no es bueno para las cosechas, echalos.
			LoveSpace: Grandes praderas, ¡ideal para una vaca grande como yo!
			FarFromHome: ¿Alguna vez escuchaste esa frase sobre las vacas volviendo a casa? Bueno, no creo que esta vaca lo vaya a hacer esta noche...
			NoHome: Que es una vaca sin un establo? Nada, eso es.
			Content: No me quejo.
		}

		Census.SpawnCondition: Alcanzar un peso de al menos Gord@
	}

	SweetSpirit.DisplayName: Espiritu Dulce

	OverflowingMimicNPC: {
		TownNPCMood: {
			HateNPC: ¡Recaudador tomar monedas doradas! ¡Malvado! ¡Lleno de avaricia!
			LikeNPC: ¡Gustar hombre bomba! ¡Tirar bombas! ¡Bum!
			DislikeNPC: Saqueador malvado y rudo, ¡intento alcanzar y encontrar tesoro! ¡Unico que saqueador encontro fue grasa!
			DislikeBiome: ¡Ser muy lindo aquí arriba! ¡No gustar para nada!
			LikeBiome: Fria comoda casa, ¡comoda y buena!
			LoveBiome: ¡Estamos muy comodos en cueva! ¡Yay!
			HateCrowded: Muchos más alrededor... ¡no bueno!
			DislikeCrowded: ¡Necesitar espacio personal!
			LoveSpace: ¡Humano construyó cofre espacioso bueno!
			FarFromHome: ¡Ayuda! ¡Haberme perdido!
			NoHome: ¡Necesitar cofre comodo para vivir dentro!
			Content: ¡Feliz!
			LikeNPC_Princess: ¡Chica rosa dar botín delicioso!
			Princess_LovesNPC: ¡Nunca vi un mímico como {NPCName} en persona antes! ¡Ella es tan linda!
		}

		DisplayName: Mímico Desbordado
		Census.SpawnCondition: Usar {$Items.PowderedSugar.DisplayName} [i:WgMod/PowderedSugar] en un mímico
	}

	SugarSpecter.DisplayName: Espectro del Azúcar
	SkeleborerHead.DisplayName: Esqueleto Poseido
	SkeleborerBody.DisplayName: Esqueleto Poseido
	SkeleborerTail.DisplayName: Esqueleto Poseido
	EncumberedStatueTop.DisplayName: Estatua Sobrecargada
	EncumberedStatueMiddle.DisplayName: Estatua Sobrecargada
	EncumberedStatueBottom.DisplayName: Estatua Sobrecargada
	OverindulgentStatueTop.DisplayName: Estatua Sobreindulgente
	OverindulgentStatueMiddle.DisplayName: Estatua Sobreindulgente
	OverindulgentStatueBottom.DisplayName: Estatua Sobreindulgente
}

Dialogue: {
	GroundedHarpy: {
		StandardDialogue1: Scraw! ¡Todavía estoy enojada contigo por hacerme tan gorda!
		StandardDialogue2: ¡No es sorpresa que los humanos no puedan volar si toda su comida es tan buena!
		StandardDialogue3: ¿Que? No, ¡no morimos cuando nos matas! Respawneamos, ¡al igual que ti! Scraw!
		StandardDialogue4: ¿Acaso tienes mas de ese polvo blanco dulce y rico? ¿"Por que"? ¡Que te importa!
		StandardDialogue5: Vivir en el suelo es aburrido, ¡quiero tocar las nubes devuelta!
		StandardDialogue6: Mataste unos cuantos malos grandes, ¿asaste su carne por la hoguera?
		StandardDialogue7: No, ¡no construimos esas casas en el cielo! Eso es un estereotipo dañino, scraw!
		StandardDialogue8: ¿Puedes acicalar mi plumaje? Se me ha hecho dificil hacerlo por mi misma desde que... ¡tu sabes!
		DayDialogue1: ¡Estas interrumpiendo mi rutina de ejercicio! ¡Voy a volar devuelta pronto!
		PartyDialogue1: ¡Las festividades humanas son tan divertidas! ¡Y deliciosas!
		PartyDialogue2: ¡Por favor dile a {0} de no jugar a ponerle la cola a la arpía!
		WindyDayDialogue1: ¡Siento que el viento me va a sacar volando!
		WindyDayDialogue2: Screech! ¡Vole! ¿Viste? ¿Que? ¿Solo fue el viento?
		BloodMoonDialogue1: ¡Acercaté más y voy a usar mis garras! Craw!
		BloodMoonDialogue2: SCRAW! ALEJATÉ!
		BloodMoonDialogue3: Huff! Huff! ¡Debo perder peso! Scree!
		HomelessDialogue1: ¡Humano! ¡Alojame inmediatamente!
		HomelessDialogue2: Tu me hiciste esto, ¡tu toma responsabilidad!
		HomelessDialogue3: Huff... huff... Necesito un lugar donde descansar...
		HardModeDialogue1: Nunca me gustaron esos dragones largos... ¡Ellos piensan que las arpías son comida!
		RainDialogue1: Screech! ¡No puedo ejercitarme en estas condiciones!
		RainDialogue2: Supongo que solo me voy a quedar en casa y comer hoy...
		RainDialogue3: ¡Hoy solo es un dia de descanso! ¿Que? ¡No estoy sobre mi limite semanal!
		StormDialogue1: SCRAW! ¡PANICO! SCRAW!
		SlimeRainDialogue1: ¿Como piensas que sabra un slime?
		LoveStruckDialogue1: Humano... Te ves mas delicioso de lo normal...
		EvilBossDialogue1: Scraw! ¡Me tome la libertad de convertir a ese gran malote en una comida para ti! Scraw!
		SkeletronDialogue1: Me encantaria hacerte un arco de tormentas de arpía tradicional, ¡pero necesitaria unos huesos muy grandes para hacerlo!
		SkeletronDialogue2: Caw! ¡Esa malvada calavera que mataste fue perfecto para construir un arco de tormentas de arpía tradicional!
		QuestFishDialogue1: No, ¡no te voy a llevar hasta los lagos del cielo por tus pescados!
		CatDialogue1: Oye... ¿puedo cuidar a {0} hoy? ¡Por ningun motivo! Es solo que podria comermelo- ¡A besos digo!
		DogDialogue1: ¡{0} me ladra todo el tiempo! ¡No soy un pajaro!
	}

	Milkmaid: {
		StandardDialogue1: Escuche que habia un heroe que no podia cuidar su peso. Supongo que ese eres tu?
		StandardDialogue2: Mis pechos producen unas bebidas unicas. Un sorbo y terminaras muy gordo para salir de la cama o flaco como un palo de escoba.
		StandardDialogue3: ¿Necesitas algo de leche? Soy tu mujer.
		StandardDialogue4: Eres una cosita muy linda, pero podrias ganar algo de peso.
		StandardDialogue5: ¿Como me volvi tan grande? Veamos... ahora, ¿fue la maquina de flan o el culto de alimentación?
		StandardDialogue6: La gente ve mis cuernos y piensan que soy un hombre. Nunca escucharon de una butch.
		StandardDialogue7: Sabes, entre todas las monstrosidades que ves por aquí, ¿a donde estan todos los animales?
		StandardDialogue8: Mis malditos overalls, se siguen achicando o algo.
		BloodMoonDialogue1: Hmph.
		BloodMoonDialogue2: Tu cara no es tan adorable como lo es normalmente, alejaté.
		BloodMoonDialogue3: ¿No hay suficiente leche para ti? Terrible.
		HomelessDialogue1: ¿No tendrias un establo de sobra en el que me pueda quedar?
		HomelessDialogue2: Eres un heroe, salva a esta pequeña chica de granja y dale algo de propiedad barata.
		HomelessDialogue3: No estoy segura si esta tierra es buena para plantar, pero con lo gordas que se ponen las mujeres, va a ser excelente para los animales.
		ArmsDealerDialogue1: Creerias que {0} dejaria de estar tan caliente cuando le dije que soy lesbiana, pero le empezó a hablar a {1} sobre reemplazo de hormonas.
		DryadDialogue1: Le ofreci a {0} una manzana de uno de mis arboles, ella me miro como si mi gordura fuera contagiosa.
		MechanicDialogue1: "{0} me dijo que iba a construir una maquina que pudiera cuidar mis cosechas por mi, yo le dije que no serian mis cosechas si no las cuidara yo misma."
		PartyDialogue1: Oye, ¿el glaceado en el pastel? De nada.
		StormDialogue1: Uf, espero que mi ganado halla llegado a casa seguro...
		StormDialogue2: Cualquiera que sea la diosa a cargo del clima, ella no es una persona muy feliz.
		RainDialogue1: Un poco de lluvia es buena para la cosecha, no significa que me tenga que gustar a mi.
		RainDialogue2: Cuando era joven, mi vieja siempre me dijo de no tomar el agua de lluvia.
		WindyDayDialogue1: Ahh, el sonido de la veleta siempre me recuerda de tiempos mejores...
		WindyDayDialogue2: Algunas veces me gusta acostarme en un campo y sentir el viento soplar... Pero es dificil levantarse despues.
		DayDialogue1: Huff, huff... phew! ¡El sol me esta matando hoy!
		DayDialogue2: Hermosura, ¿me puedes buscar algo frio para tomar? Eh, ¿tal vez unas cuantas cosas frias?
		LoveStruckDialogue1: Mroo~ Porque no vienes a encontrarme detras de mi establo, amor~?
		LoveStruckDialogue2: Mmph... Siento que estoy en celo de golpe... ¿Puedes darme un poco de espacio?
		Milked1: Mrooo~
		Milked2: Hrmph... eres demasiado gentil.
		Milked3: Uhf, ¿eso es todo? Maldicion...
		MilkedDeny: Vuelve mañana, hm?
		BloodMilked1: Hrmph. Saca las manos.
		BloodMilked2: ¡ALEJATÉ!
		BloodMilked3: A la proxima voy a pegar patadas.
		BloodMilkedDeny: Ya tienes tu leche, sal de aqui.
	}

	OverflowingMimic: {
		StandardDialogue1: Por que hacer a {0} grande, ¿humano? ¡Humano malo! ¡Malo!
		StandardDialogue2: Bwah! ¡No mires la barriga de {0}!
		StandardDialogue3: ¡Slime como {0} puede montar cofre! ¡Verse como botín!
		StandardDialogue4: ¿Tu nombre {1}? ¡Ese nombre tonto! ¡{0} nombre mejor!
		StandardDialogue5: Cofre de {0} se esta volviendo muy pesado para saltar... ¡culpa humano!
		StandardDialogue6: Hambre... ¡{1}! Dar {0} comida! ¡Ahora!
		StandardDialogue7: Podria {1} uhmm... enseñar {0} como funcionan puertas denuevo?
		StandardDialogue8: Uuurrp... {0} encontro un pequeño conejo... ¡muy rico!
		BloodMoonDialogue1: GRAHAHA! LA LUNA HAMBRIENTA ESTA NOCHE!
		BloodMoonDialogue2: ¡COMER TODO! ¡COMER A TODOS!
		BloodMoonDialogue3: OOUUURRRPP...
		HomelessDialogue1: ¡Humano malo! ¡Dar {0} un hogar!
		HomelessDialogue2: ¿Puede humano hacer un cofre muy muy grande para {0}?
		HomelessDialogue3: ¡{0} muy gordo para cofre! ¡Oh no!
		PartyDialogue1: ¡{0} intento tomar siesta y humanos pusieron tazas arriba de {0}! ¡Muy grosero!
		PartyDialogue2: Woo woo woo! ¡Bailar bailar!
		StormDialogue1: Humano, ¡ayuda! ¡Hay monstruo gigante ruidoso afuera!
		StormDialogue2: AH! ¡HUIR!
		RainDialogue1: Lluvia lluvia, vete ya...
		RainDialogue2: "{0} taaaaan aburrida... ¡querer jugar afuera!"
		RainDialogue3: ¿Acaso {1} saber hechizo para parar lluvia?
		WindyDayDialogue1: Cielo intento robarse a {0}, pero {0} muy pesada!
		WindyDayDialogue2: "{0} watch the plants dance all day... so pretty..."
		DayDialogue1: ¡Dia lindo! ¡Lleno de juegos!
		NightDialogue1: "{0} amar anochecer, ¡tantos amigos afuera con los que jugar!"
		LoveStruckDialogue1: "{1}... {0} un poco quiere... morder cara de {1}..."
		PostMechDialogue1: "{0} comio la carne de grandes robots... {0} sentirse tan poderosa..."
	}

	Nurse: {
		PlayerStage1: Si necesitas consejos de dieta, tengo una seleccion de libros sobre el tema.
		PlayerStage2: Si necesitas consejos de dieta, tengo una seleccion de libros sobre el tema.
		PlayerStage3: Has engordado mas desde tu ultima consulta.
		PlayerStage4: Eres medicamente obes@. Esto es serio, necesitas perder peso.
		PlayerStage5: Ahora eres morbidamente obes@. Te voy a prescribir una dieta y rutina de ejercicio, apegate a ella antes de que te conviertas en una historia de advertencia.
		PlayerStage6:
			'''
			Si rompes mi puerta voy a agregarlo a tu factura.
			Deja de ignorar mis consejos, todavia puedes dar vuelta esto.
			'''
		PlayerStage7: ¿Acaso te puedes mover todavia?
		PlayerStage8:
			'''
			Incluso en este tamaño, todavia hay unos ejercicios que te pueden ayudar a manejar este peso.
			Al menos tu acceso a comida fue restringido.
			'''
		PlayerStage9:
			'''
			Estoy impresionada y asqueada.
			No hay terminos medicos oficiales para tu peso.
			No tengo ningun otro consejo de perdida de peso para ti, no es que alguna vez hayas escuchado.
			'''
		PlayerFatPlus: Entiendo que las pociónes sean utiles, pero tambien estan llenas de calorias. Usalas con moderación.
		PlayerObesePlusPartyGirl: Las malas influencias solo van a empeorar tus problemas de peso, no los escuches.
		PlayerObesePlusGoblinMechanic: A pesar de su comodidad, las asistencias de mobilidad solo empeoran el problema al deprivarte de actividad fisica, por favor, no las uses.
		PlayerBarelyMobilePlusPartyGirl: Alejate de {0}, puede ser la ultima vez que camines.
		PlayerBarelyMobilePlusBlood: ¡Solo para de comer!
		PlayerEncumberedPlusParty: ¡No, nisiquiera puedes tener un dia de indulgencia!
		ZoologistFat: Alguien tiene que decirle a {0} de cuidar su cuerpo.
		ZoologistFatPlayerFat: Alguien tiene que decirle a {0} de cuidar su cuerpo, ¡y tu ni le digas sobre tu dieta!
		DryadFat: La "fuerza de la naturaleza" no es una excusa para que {0} se deje llevar.
		DryadFatPlayerFat: Deja de darle soda a las plantas, esta haciendo que {0} engorde.
		MonstersFat: Por favor, no engordes a los monstruos.
		MonstersFatPlayerFat: Por favor, no compartas tu dieta con los monstruos.
		Milkmaid: Ser una vaca no es una excusa para que {0} sea gorda, ella necesita perder peso.
		MilkmaidPlayerFat: Deja de aceptar los productos de lactosa de {0}, te estan haciendo engordar.
	}

	Dryad: {
		PlayerStage1: Estuviste disfrutando de los regalos de la naturaleza.
		PlayerStage2: Estuviste disfrutando de los regalos de la naturaleza.
		PlayerStage3: Mantente delgad@; Terraria necesita a alguien en forma!
		PlayerStage4: Se supone que los heroes deberian estar delgados.
		PlayerStage5: Una barriga como esa no es apta para alguien que deberia estar limpiando la tierra.
		PlayerStage6: Hay demonios del gluto mas delgados que ti.
		PlayerStage7: Se supone que los heroes son móviles.
		PlayerStage8: No eres un arbol, no deberias estar pegado al suelo en un lugar asi.
		PlayerStage9: ¿Acaso puedes ver mas alla de tu {0}?
		PlayerObesePlus: La corrupción puede tomar muchas formas, sucumber al hambre de uno mismo es una de esas formas.
		PlayerMorbidlyObesePlus: La generosidad de la naturaleza es para todos, por favor guarda un poco para los demas.
		PlayerEncumberedPlus: Me pregunto cuantos animales podrian vivir con tu dieta.
		Fat: Solo es la fuerza de la naturaleza haciendome gorda.
		FatRaining: La lluvia hace imposible que una dríada pierda peso.
		FatRainingHomeless: ¡Necesito un techo antes de que me vuelva mas ancha de lo que soy alta!
		FatNurse: Puedes decirle a {0} que deje de molestarme?
		FatJungle:
			'''
			La abundancia de naturaleza aqui hace que sea dificil que una dríada regule su peso.
			Ya he aceptado que la humedad me va a mantener gorda.
			'''
		FatDesert: Solo es peso de agua, lo necesito aqui.
		FatPlayerFat: Tu entiendes que dificil es perder peso.
		FatPlayerFatNurse: No le digas a {0}, pero ya estoy haciendo todo lo posible por mantenerme delgada.
		FatPlayerNotMobile: Por mucho que odie ser gorda, la inmóvilidad solo se siente apropiada.
		OverflowingMimic: Se supone que ibas a desterrar el mal, no alimentarlo.
		FattenedWildlife: Tu necesidad de engordar la fauna es insultante.
		Milkmaid: Puedo aceptar que {0} sea gorda ya que es una vaca, es solo natural.
		ZoologistFat: Es una pena ver a alguien como {0} caer en la gula.
	}
}

Bestiary: {
	GroundedHarpy: Un arpía que antes era libre y feliz, ¡engordada hasta que ya no pudo volar! Va a proveerte con materiales utiles del cielo, a regañadientes.
	Milkmaid: Una chica vaca simple y amable, ¡sus tetinas magicas producen malteadas que pueden cambiar instantaneamente el peso de quien lo beba! Regularmente visita bares lesbianos.
	OverflowingMimic: Los mímicos son una forma de slime que actua de una manera muy similar a los cangrejos hermitaños, moviendose de cofre en cofre mientras crecen. Pero este puede ya ser un poco grande para su cofre...
	HomingFood: Comida maldecida por un espiritu malevoló para buscar y engordar aventureros hasta que esten indefensos.
	SweetSpirit: Estos espiritus que habitan las cavernas haran su mejor esfuerzo por engordarte.
	SugarSpecter: Espectros hechos de azúcar condensada y algodón de azúcar. Matalos antes de que te hagan subir de peso...
	Skeleborer: Algunas veces, grandes cantidades de ectoplasma se juntan, ¡y vienen a la vida! Ella es atormentada por los gritos de miles de almas, pero realmente no le importa.
	EncumberedStatue: Una estatua que parece ser el habitada por un fantasma. A pesar de ser incapaz de moverse, parece feliz.
	OverindulgentStatue: Una estatua con proporciones exageradas. No hay mucho mas que se pueda decir sobre esto, realmente.
}

