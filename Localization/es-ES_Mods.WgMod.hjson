			'''
			Permite vuelo
			El usuario puede correr super rapido
			Reduce la velocidad de movimiento gordo por {0}%
			'Por cierto, te ves genial. Muy saludable.'
			'''
	}

	TerraskeletonLegs: {
		DisplayName: Piernas de Terraesqueleto
		Tooltip:
			'''
			Permite vuelo, correr super rapido, y mobilidad extra sobre hielo
			Aumenta la velocidad de movimiento por {0}% y reduce la penalidad de movimiento gordo por {2}%
			Proporciona la habilidad de caminar en agua, miel & lava
			Otorga inmunidad a los bloques de fuego y {1} segundos de inmunidad a la lava
			Reduce el daño de tocar lava
			'''
	}

	FlaskOfAmbrosia: {
		DisplayName: Frasco de Ambrosía
		Tooltip:
			'''
			Una bebida poderosa pero profundamente engordadonte
			¡Aumenta tu velocidad de movimiento, aceleración, regeneración, y defensa al recibir daño!
			Los efectos escalan con tu obesidad
			'''
	}

	QueenlyGluttony: {
		DisplayName: Gula Real
		Tooltip:
			'''
			Aumenta el daño melee por {0}%, posibilidad de golpe critico por {2}%, y penetración de armadura por {3}
