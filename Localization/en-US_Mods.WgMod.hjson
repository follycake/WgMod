Configs: {
	WgServerConfig: {
		DisplayName: Wg Server Config
		Headers.General: General settings

		DisableFatBuffs: {
			Label: Disable Fat Buffs
			Tooltip: Disables fat buffs and debuffs, status buffs like 'Gaining' will still apply
		}

		DisableFatHitbox: {
			Label: Disable Fat Hitbox
			Tooltip: Disables player hitbox size changes
		}

		DisablePlayerPushing: {
			Label: Disable Player Pushing
			Tooltip: Disables players pushing around other players and NPCs with their fat
		}
	}

	WgClientConfig: {
		DisplayName: Wg Client Config

		Headers: {
			General: General settings
			Visual: Visual settings
			Sprites: Sprites
			Volume: Gurgle Volume
		}

		DisableJiggle: {
			Label: Disable Jiggle
			Tooltip: Disables jiggle effects
		}

		DisableUVClothes: {
			Label: Disable UV Clothes
			Tooltip: Disables dynamic armor and clothes feature
		}

		ShowCredits: {
			Label: Show Credits
			Tooltip: Shows credits on tooltips
		}

		DisableWeightGain: {
			Label: Disable Weight Gain
			Tooltip: Disables gaining weight of any kind
		}

		PlayerSpriteSet: {
			Label: Player Sprite Set
			Tooltip: Controls the aspect of fat player sprites
		}

		GurgleVolume: {
			Tooltip: The volume of gurgles compared to the rest of the game's audio, setting it to 0 mutes gurgles entirely.
			Label: Gurgle Volume
		}

		UseImperialUnits: {
			Label: Use Imperial Units
			Tooltip: Use imperial (lbs) units instead of metric (kg)
		}
	}

	WorkshopIconsConfig: {
		DisplayName: Past Workshop Icons
		Headers.WorkshopIcons: Past Workshop Icons

		WorkshopIcons: {
			Label: Select Version
			Tooltip:
				'''
				This config doesn't actually change anything in the game!
				It exists exclusively to look at the old workshop icons after they've changed!

				Select the version icon you want to see!
				'''
		}

		CurrentIcon: {
			Label: Current Icon
			Tooltip: ""
		}
	}
}

